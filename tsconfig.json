{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "lib": ["es2022", "dom"],
    "module": "commonjs",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "ops/**/*.ts"]
}
