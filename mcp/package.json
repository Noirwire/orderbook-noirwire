{
  "name": "@noirwire/orderbook-mcp",
  "version": "0.1.0",
  "description": "An MCP server that lets an AI agent trade on NoirWire's private order book on Solana devnet, with test money.",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "devnet",
    "order-book",
    "trading",
    "ai-agent"
  ],
  "homepage": "https://terminal.noirwire.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noirwire/orderbook-noirwire.git",
    "directory": "mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
