{
  "name": "@noirwire/orderbook",
  "version": "0.3.2",
  "description": "The client for NoirWire's private order book: addresses, instructions, account decoders, one-time order keys and receipts.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.3",
    "@noble/hashes": "1.8.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
